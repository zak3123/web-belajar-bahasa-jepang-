/* ========================================
   ENHANCED SAKURA & JAPANESE UI STYLES
   ======================================== */

/* Enhanced Sakura Colors & Effects */
:root {
    --sakura-pink-1: #ffb7c5;
    --sakura-pink-2: #ff9eb5;
    --sakura-pink-3: #ff8aa2;
    --sakura-white: #fff5f8;
    --sakura-shadow: rgba(255, 183, 197, 0.3);
    --japanese-red: #c91818; /* Traditional Japanese Red */
    --japanese-gold: #c9a946; /* Traditional Gold */
    --japanese-ink: #1a1a1a; /* Sumi Ink Black */
    --washi-paper: #faf8f5; /* Rice Paper Texture */
}

.sakura-layer {
    z-index: 70;
    overflow: hidden;
}

/* More sakura petals falling */
.sakura-petal {
    position: absolute;
    top: -8vh;
    left: var(--x);
    width: var(--size);
    height: calc(var(--size) * 0.72);
    border-radius: 70% 35% 70% 35%;
    opacity: var(--opacity);
    background:
        radial-gradient(circle at 30% 30%, var(--sakura-white), transparent 35%),
        linear-gradient(
            145deg, 
            var(--sakura-pink-1), 
            var(--sakura-pink-2) 40%,
            var(--sakura-pink-3) 80%
        );
    box-shadow: 
        0 4px 8px var(--sakura-shadow),
        inset 0 -2px 4px rgba(255, 255, 255, 0.4);
    transform: rotate(var(--rotate));
    animation: 
        sakura-fall var(--duration) linear var(--delay) infinite,
        sakura-sway calc(var(--duration) * 0.34) ease-in-out var(--delay) infinite alternate;
}

/* Additional soft glow around petals */
.sakura-petal::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 70% 35% 70% 35%;
    background: radial-gradient(circle, rgba(255,255,255,0.6), transparent 70%);
    opacity: 0.6;
}

/* Multiple sakura layers for depth */
.sakura-layer:nth-child(1) {
    animation-duration: 18s;
}

.sakura-layer:nth-child(2) {
    animation-duration: 14s;
    filter: blur(1px);
}

.sakura-layer:nth-child(3) {
    animation-duration: 22s;
    filter: blur(2px);
    opacity: 0.7;
}

/* Enhanced vignette with traditional patterns */
.sakura-vignette {
    z-index: 1;
    opacity: 0.6;
    background:
        radial-gradient(circle at 10% 20%, rgba(255, 183, 197, 0.2), transparent 20rem),
        radial-gradient(circle at 90% 80%, rgba(255, 158, 181, 0.18), transparent 22rem),
        repeating-linear-gradient(
            45deg,
            transparent,
            transparent 10px,
            rgba(255, 245, 248, 0.03) 10px,
            rgba(255, 245, 248, 0.03) 20px
        );
}

/* Japanese-inspired card backgrounds */
.lesson-card,
.flashcard,
.quiz-question {
    background: 
        linear-gradient(135deg, var(--washi-paper) 0%, #fffefb 100%),
        url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><pattern id="washi" x="0" y="0" width="50" height="50"><circle cx="25" cy="25" r="1" fill="%23e8e0d5"/></pattern><rect width="100" height="100" fill="url(%23washi)"/></svg>');
    border: 1px solid rgba(201, 59, 43, 0.15);
}

/* Traditional Japanese border accents */
.lesson-card::before,
.flashcard::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border: 2px solid transparent;
    border-image: linear-gradient(135deg, var(--japanese-red), var(--japanese-gold)) 1;
    border-radius: inherit;
    pointer-events: none;
}

/* Japanese-style header bar */
.topbar {
    position: sticky;
    top: 12px;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 22px;
    margin-bottom: 28px;
    border: 2px solid rgba(201, 59, 43, 0.2);
    border-radius: 12px;
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 250, 246, 0.9) 50%, rgba(255, 245, 240, 0.85) 100%),
        linear-gradient(45deg, rgba(255, 183, 197, 0.1), rgba(201, 59, 43, 0.05));
    box-shadow: 
        0 8px 24px rgba(201, 59, 43, 0.15),
        0 2px 8px rgba(0, 0, 0, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
}

/* Japanese-style button accents */
button,
.nav button.is-active,
.start-btn,
.retry-btn {
    position: relative;
    overflow: hidden;
}

button::after,
.nav button.is-active::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(201, 59, 43, 0.15);
    transform: translate(-50%, -50%);
    transition: width 0.6s ease, height 0.6s ease;
}

button:hover::after,
.nav button.is-active:hover::after {
    width: 300px;
    height: 300px;
}

/* Better vocabulary layout for long words */
.vocab-item,
.example-entry {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px 16px;
    align-items: start;
    word-break: break-word;
}

.vocab-term {
    font-size: 1.2em;
    font-weight: 600;
    color: var(--japanese-ink);
    min-width: 80px;
    text-align: left;
    white-space: normal;
}

.vocab-meaning {
    color: var(--ink-soft);
    line-height: 1.5;
}

.vocab-romaji {
    font-size: 0.9em;
    color: var(--accent);
    font-style: italic;
    text-align: right;
}

/* Japanese-style section dividers */
.section-divider {
    height: 2px;
    background: 
        repeating-linear-gradient(
            90deg,
            var(--japanese-red),
            var(--japanese-red) 10px,
            transparent 10px,
            transparent 20px
        );
    margin: 24px 0;
    opacity: 0.6;
}

/* Enhanced quiz card with Japanese aesthetic */
.active-quiz .question-card {
    border-left: 4px solid var(--japanese-red);
    background: linear-gradient(
        90deg, 
        rgba(255, 255, 255, 0.95) 0%, 
        rgba(255, 245, 240, 0.9) 100%
    );
}

/* Floating kanji background pattern */
body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><text x="20" y="40" font-size="20" fill="%23c9a946" opacity="0.03">学</text><text x="120" y="100" font-size="20" fill="%23c9a946" opacity="0.03">習</text><text x="40" y="160" font-size="20" fill="%23c9a946" opacity="0.03">勉</text></svg>');
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
}

/* Japanese-style progress bars */
.progress-bar {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(
        90deg, 
        var(--japanese-red) 0%, 
        var(--japanese-gold) 100%
    );
    position: relative;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: 
        repeating-linear-gradient(
            45deg,
            transparent,
            transparent 5px,
            rgba(255, 255, 255, 0.3) 5px,
            rgba(255, 255, 255, 0.3) 10px
        );
}

/* Cherry blossom hover effects */
.lesson-link:hover .lesson-title {
    color: var(--japanese-red);
    text-shadow: 0 0 8px rgba(255, 183, 197, 0.4);
}

.lesson-link::after {
    content: '🌸';
    margin-left: 8px;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s ease;
}

.lesson-link:hover::after {
    opacity: 1;
    transform: translateY(0);
}

/* Mobile responsive adjustments */
@media (max-width: 768px) {
    .vocab-item {
        grid-template-columns: 1fr;
        gap: 4px;
    }
    
    .vocab-term {
        min-width: auto;
    }
    
    .sakura-petal {
        --size: 8px !important;
    }
}

/* Enhanced sakura fall animation with wind effect */
@keyframes sakura-fall {
    0% {
        transform: translate3d(0, -10vh, 0) rotate(var(--rotate));
        filter: blur(0px);
    }
    
    50% {
        filter: blur(1px);
    }
    
    100% {
        transform: translate3d(var(--drift), 112vh, 0) rotate(calc(var(--rotate) + 720deg));
        filter: blur(0px);
    }
}

/* Wind sway for branches */
@keyframes sakura-sway {
    from {
        transform: translateX(-8px) rotate(-5deg);
    }
    
    to {
        transform: translateX(8px) rotate(5deg);
    }
}

/* Bloom burst with multiple colors */
@keyframes sakura-bloom {
    0% {
        opacity: 0;
        transform: translate3d(0, 0, 0) scale(0.3) rotate(0deg);
        filter: blur(5px);
    }
    
    20% {
        opacity: 1;
        filter: blur(0px);
    }
    
    100% {
        opacity: 0;
        transform: translate3d(var(--burst-dx), var(--burst-dy), 0) scale(1.15) rotate(var(--burst-rotate));
        filter: blur(2px);
    }
}

/* Reduced motion respects user preference */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition: none !important;
    }
    
    .sakura-layer {
        display: none;
    }
}
