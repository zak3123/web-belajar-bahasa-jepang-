            "romaji": "Renshu sure jouzu ni narimasu",
            "id": "Kalau berlatih jadi terampil"
          },
          {
            "jp": "雨が降れば行きません",
            "romaji": "Ame ga fureba ikimasen",
            "id": "Kalau hujan, tidak pergi"
          }
        ]
      }
    ],
    "connectives": [
